# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://postgres:password@localhost:5432/gym_saas?schema=public"

# ========================
# JWT
# ========================
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ========================
# APP
# ========================
NODE_ENV="development"
API_PORT=4000
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:3000"

# ========================
# MERCADO PAGO
# ========================
MP_ACCESS_TOKEN="your-mp-access-token"
MP_PUBLIC_KEY="your-mp-public-key"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# ========================
# EMAIL (SMTP / Resend)
# ========================
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="your-resend-api-key"
SMTP_FROM="GymSaaS <noreply@gymsaas.app>"

# ========================
# WHATSAPP (Evolution API / Twilio)
# ========================
WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="gym_saas"

# ========================
# PUSH NOTIFICATIONS (Firebase)
# ========================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# ========================
# STORAGE (S3 / Cloudflare R2)
# ========================
STORAGE_PROVIDER="s3"
S3_BUCKET="gym-saas-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_ENDPOINT=""

# ========================
# REDIS (caching & queues)
# ========================
REDIS_URL="redis://localhost:6379"

# ========================
# NEXT.JS PUBLIC
# ========================
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_MP_PUBLIC_KEY="your-mp-public-key"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-firebase-vapid-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
