// GymSaaS — Prisma Schema v1.0
// Multi-tenant SaaS for gyms

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// TENANT (GYM)
// =============================================

model Gym {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  legalName     String?
  taxId         String?
  email         String
  phone         String?
  whatsapp      String?
  address       String?
  city          String?
  state         String?
  country       String   @default("AR")
  logoUrl       String?
  coverUrl      String?
  website       String?
  timezone      String   @default("America/Argentina/Buenos_Aires")
  currency      String   @default("ARS")
  mpAccessToken String?
  mpPublicKey   String?
  plan          GymPlan  @default(STARTER)
  planExpiresAt DateTime?
  isActive      Boolean  @default(true)
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  members       Member[]
  exercises     Exercise[]
  routines      Routine[]
  payments      Payment[]
  scheduleSlots ScheduleSlot[]
  attendances   Attendance[]
  notifications Notification[]
  announcements Announcement[]
  holidays      Holiday[]
  reports       Report[]

  @@map("gyms")
}

enum GymPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// =============================================
// USER (STAFF + MEMBERS)
// =============================================

model User {
  id           String    @id @default(cuid())
  gymId        String
  email        String
  phone        String?
  passwordHash String
  role         UserRole  @default(MEMBER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  fcmToken     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        Member?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@unique([gymId, email])
  @@index([gymId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  TRAINER
  RECEPTIONIST
  MEMBER
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================
// MEMBER (ALUMNO)
// =============================================

model Member {
  id          String       @id @default(cuid())
  gymId       String
  userId      String?      @unique
  dni         String?
  firstName   String
  lastName    String
  birthDate   DateTime?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  photoUrl    String?
  emergencyContact String?
  emergencyPhone   String?
  medicalNotes     String?
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  gym            Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])
  routineAssigns RoutineAssign[]
  payments       Payment[]
  attendances    Attendance[]
  reservations   Reservation[]
  bodyMetrics    BodyMetric[]
  progressPhotos ProgressPhoto[]

  @@index([gymId])
  @@index([gymId, status])
  @@map("members")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

// =============================================
// EXERCISE LIBRARY
// =============================================

model ExerciseCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  iconUrl   String?
  exercises Exercise[]

  @@map("exercise_categories")
}

model Exercise {
  id           String   @id @default(cuid())
  gymId        String?
  categoryId   String?
  name         String
  description  String?
  muscleGroups String[]
  equipment    String[]
  difficulty   Difficulty @default(BEGINNER)
  imageUrl     String?
  videoUrl     String?
  thumbnailUrl String?
  isGlobal     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym             Gym?              @relation(fields: [gymId], references: [id])
  category        ExerciseCategory? @relation(fields: [categoryId], references: [id])
  routineExercises RoutineExercise[]

  @@index([gymId])
  @@index([categoryId])
  @@map("exercises")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// =============================================
// ROUTINES
// =============================================

model Routine {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  goal        String?
  durationWeeks Int    @default(4)
  description String?
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym              Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercises        RoutineExercise[]
  assignments      RoutineAssign[]

  @@index([gymId])
  @@map("routines")
}

model RoutineExercise {
  id         String  @id @default(cuid())
  routineId  String
  exerciseId String
  dayOfWeek  Int     @default(1)
  order      Int     @default(0)
  sets       Int     @default(3)
  reps       String  @default("10")
  weight     String?
  restSecs   Int     @default(60)
  notes      String?

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([routineId])
  @@map("routine_exercises")
}

model RoutineAssign {
  id          String   @id @default(cuid())
  memberId    String
  routineId   String
  assignedAt  DateTime @default(now())
  startsAt    DateTime @default(now())
  expiresAt   DateTime
  renewedAt   DateTime?
  isActive    Boolean  @default(true)
  notes       String?
  trainerId   String?

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id])

  @@index([memberId])
  @@index([expiresAt])
  @@map("routine_assigns")
}

// =============================================
// PAYMENTS / QUOTES
// =============================================

model PaymentPlan {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("ARS")
  durationDays Int     @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@index([gymId])
  @@map("payment_plans")
}

model Payment {
  id             String        @id @default(cuid())
  gymId          String
  memberId       String
  planId         String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("ARS")
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(CASH)
  mpPaymentId    String?       @unique
  mpPreferenceId String?
  mpStatus       String?
  receiptUrl     String?
  notes          String?
  dueDate        DateTime?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gym    Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   PaymentPlan? @relation(fields: [planId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MERCADO_PAGO
  OTHER
}

// =============================================
// SCHEDULES & RESERVATIONS
// =============================================

model ScheduleSlot {
  id           String      @id @default(cuid())
  gymId        String
  name         String
  trainerId    String?
  dayOfWeek    Int
  startTime    String
  endTime      String
  capacity     Int         @default(20)
  isActive     Boolean     @default(true)
  color        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([gymId])
  @@map("schedule_slots")
}

model Reservation {
  id        String            @id @default(cuid())
  memberId  String
  slotId    String
  date      DateTime
  status    ReservationStatus @default(CONFIRMED)
  createdAt DateTime          @default(now())

  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  slot   ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([memberId, slotId, date])
  @@index([slotId, date])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model Holiday {
  id        String   @id @default(cuid())
  gymId     String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, date])
  @@index([gymId])
  @@map("holidays")
}

// =============================================
// ATTENDANCE
// =============================================

model Attendance {
  id           String   @id @default(cuid())
  gymId        String
  memberId     String
  checkedInAt  DateTime @default(now())
  checkedOutAt DateTime?
  method       String   @default("QR")
  notes        String?

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, checkedInAt])
  @@index([memberId])
  @@map("attendances")
}

// =============================================
// NUTRITION & BODY METRICS
// =============================================

model BodyMetric {
  id           String   @id @default(cuid())
  memberId     String
  recordedAt   DateTime @default(now())
  weight       Float?
  height       Float?
  bmi          Float?
  bodyFat      Float?
  muscleMass   Float?
  waist        Float?
  chest        Float?
  hip          Float?
  arm          Float?
  thigh        Float?
  notes        String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("body_metrics")
}

model ProgressPhoto {
  id         String   @id @default(cuid())
  memberId   String
  url        String
  angle      String   @default("FRONT")
  takenAt    DateTime @default(now())
  notes      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("progress_photos")
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id        String               @id @default(cuid())
  gymId     String
  memberId  String?
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  status    NotifStatus          @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime             @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([status])
  @@map("notifications")
}

enum NotificationType {
  PAYMENT_DUE
  PAYMENT_OVERDUE
  ROUTINE_EXPIRING
  ROUTINE_RENEWED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  ANNOUNCEMENT
  WELCOME
  CUSTOM
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
  SMS
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Announcement {
  id          String   @id @default(cuid())
  gymId       String
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("announcements")
}

// =============================================
// AUDIT
// =============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =============================================
// REPORTS (cached snapshots)
// =============================================

model Report {
  id        String   @id @default(cuid())
  gymId     String
  type      String
  period    String
  data      Json
  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, type])
  @@map("reports")
}
